{
  "name": "helpdesk",
  "version": "1.0.0",
  "private": true,
  "description": "Support-ticket system: Angular, Express and PostgreSQL, with role-based access and a ticket state machine.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @helpdesk/api",
    "dev:web": "npm run start -w @helpdesk/web",
    "build": "npm run build -w @helpdesk/web",
    "vercel-build": "node scripts/vercel-build.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @helpdesk/api && npm run typecheck -w @helpdesk/web",
    "test": "npm test -w @helpdesk/api",
    "test:coverage": "npm test -w @helpdesk/api -- --coverage",
    "test:int": "npm run test:int -w @helpdesk/api",
    "e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "db:migrate": "npm run db:migrate -w @helpdesk/api",
    "db:seed": "npm run db:seed -w @helpdesk/api",
    "db:reset": "npm run db:reset -w @helpdesk/api",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "angular-eslint": "^18.4.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.0",
    "typescript": "~5.5.0",
    "typescript-eslint": "^8.8.0"
  }
}
